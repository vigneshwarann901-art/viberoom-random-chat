# IMPORTANT: production authentication/profile persistence requires a Supabase project.
# Copy to .env locally and fill these values. Never commit .env.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Optional but privileged. Needed only for server-side Supabase Admin API account deletion.
# Keep private and never expose in VITE_* variables or frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional STUN/TURN config. TURN is strongly recommended for reliable calls across restrictive networks.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional features
ENABLE_CREDIT_ENFORCEMENT=false
PORT=8080
