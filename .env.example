# Comma-separated STUN server URLs. These defaults are for development.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN relay settings. Use credentials from your TURN provider.
# Do not commit real credentials. Configure them in the hosting dashboard for deployment.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Local backend port; production hosting usually injects PORT.
PORT=8080
