{
  "name": "viberoom",
  "version": "2.0.0",
  "private": true,
  "description": "VibeRoom \u2014 authenticated random WebRTC video chat with Supabase profiles and gender-preference matchmaking",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -k \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "node --watch server.js",
    "client:dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server.js",
    "test": "node test.js",
    "check": "node --check server.js && node --check test.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
